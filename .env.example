# ===== Discord (obbligatorio) =====
DISCORD_TOKEN=
CLIENT_ID=
# Opzionale: ID del tuo server. Se impostato i comandi si aggiornano subito (consigliato in fase di test)
GUILD_ID=

# ===== Moderazione AI (opzionale) =====
# Chiave API Anthropic (https://console.anthropic.com). Senza chiave restano attivi solo i controlli anti-spam classici.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Opzionale: Google Safe Browsing per bloccare link di phishing/malware
SAFE_BROWSING_API_KEY=

# ===== Verifica nuovi membri via link esterno =====
# URL pubblico raggiungibile da internet dove gira il bot (es. https://bot.tuodominio.it o un tunnel Cloudflare/ngrok)
PUBLIC_URL=
PORT=3000
# Dashboard web (/dashboard): Developer Portal -> OAuth2 -> Client Secret
# e aggiungi come Redirect: PUBLIC_URL/dashboard/callback
DISCORD_CLIENT_SECRET=
# Opzionale ma consigliato: Cloudflare Turnstile (captcha gratuito) https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ===== Notifiche social =====
# Twitch: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# X (Twitter): bearer token dell'API ufficiale (a pagamento / limiti stretti)...
X_BEARER_TOKEN=
# ...oppure un'istanza RSS (es. RSSHub o Nitter) senza slash finale, es. https://rsshub.tuodominio.it/twitter/user
X_RSS_BASE=
# Ogni quanti secondi controllare le notifiche (minimo consigliato 60)
POLL_SECONDS=120

# Cartella dove salvare i dati (impostazioni, strike, iscrizioni)
DATA_DIR=data
